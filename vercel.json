{
  "framework": null,
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/blog-post.html" },
    { "source": "/media/:name", "destination": "/api/img?n=:name" }
  ],
  "headers": [
    { "source": "/admin.html", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] },
    { "source": "/blog-post.html", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}
